{
  "name": "jonesthecode-blog",
  "version": "9.0.0",
  "description": "jonesthecode blog and portfolio, built with Eleventy.",
  "type": "module",
  "scripts": {
    "watch:sass": "sass --watch _src/sass:_site/css",
    "build:sass": "sass _src/sass:_site/css",
    "watch:eleventy": "eleventy --serve --quiet",
    "build:eleventy": "eleventy",
    "start": "npm-run-all build:sass --parallel watch:*",
    "build": "npm-run-all build:*"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/oddjones/eleventy-base-blog.git"
  },
  "author": {
    "name": "Dominic Jones",
    "email": "info@jonesthecode.com",
    "url": "https://jonesthecode.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/oddjones/eleventy-base-blog/issues"
  },
  "homepage": "https://jonesthecode.com/",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "luxon": "^3.7.2",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.102.0"
  }
}
